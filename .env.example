# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# NextAuth configuration
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App URL for email links
APP_URL="http://localhost:3000"

# SMTP configuration for email sending
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Project Tracker <noreply@example.com>"

# Incoming email task agent (Mail.ru defaults shown)
IMAP_HOST="imap.mail.ru"
IMAP_PORT="993"
IMAP_SECURE="true"
# If omitted, SMTP_USER and SMTP_PASSWORD are reused.
IMAP_USER="your-email@example.com"
IMAP_PASSWORD="your-mail-app-password"
# Comma-separated addresses. If omitted, active app users and SMTP_USER are allowed.
EMAIL_TASK_ALLOWED_SENDERS=""

# Claude agent
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"
