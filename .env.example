# --- База данных ---
# Строка подключения к вашей PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/project_tracker?schema=public"

# --- NextAuth ---
# Сгенерируйте случайную строку, например: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Email / SMTP ---
# Заполните данными вашего почтового сервиса (Yandex, Mail.ru, SendGrid, Mailgun и т.д.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Project Tracker <no-reply@example.com>"

# --- Адрес сайта (используется в письмах для формирования ссылок) ---
APP_URL="http://localhost:3000"
